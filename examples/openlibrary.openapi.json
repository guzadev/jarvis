{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Library",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://openlibrary.org"
    }
  ],
  "paths": {
    "/search.json": {
      "get": {
        "operationId": "buscar_libros",
        "summary": "Buscar libros por tema o título",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de libros en JSON"
          }
        }
      }
    }
  }
}
